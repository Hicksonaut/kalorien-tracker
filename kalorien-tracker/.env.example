# Geteilter Token fuer die Server-zu-Server-Aufrufe zwischen Tracker und Dashboard.
# Gleicher Wert in ~/kalorien-tracker/.env und ~/garmin-dashboard/.env.
# Erzeugen: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TOKEN=

# Optional: Verbindung zum Garmin-Dashboard. Leer lassen, wenn es nicht laeuft -
# dann gilt das Ersatzbudget aus den Einstellungen und Wasser bleibt lokal.
# DASHBOARD_URL=
